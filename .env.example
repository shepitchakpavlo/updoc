# Дефолти вже працюють для `make dev` без .env (див. docker-compose.yml і drizzle.config.ts).
# Копіюйте у .env лише для перевизначення.

DATABASE_URL=postgres://updoc:updoc@localhost:5432/updoc

# База лінка форми, який повертає POST /applications: {APP_BASE_URL}/a/{token}
APP_BASE_URL=http://localhost:5173

# Google Drive (тикет 03): тестова папка Павла + сервісний акаунт.
# СЕКРЕТИ ПОЗА РЕПО: JSON-ключ сервісного акаунта лежить поза репо,
# тут — лише шлях до нього (стандартна змінна GCP).
GOOGLE_DRIVE_TEST_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=
