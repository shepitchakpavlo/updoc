{
  "name": "updoc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "UpDoc — збір і перевірка HR-документів нових працівників",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @updoc/api\" \"npm run dev -w @updoc/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @updoc/api",
    "db:migrate": "npm run db:migrate -w @updoc/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "^5.9.3"
  }
}
